# The public demo's front door. A cookie gate instead of HTTP basic auth,
# so visitors get a real login form in the page — never the browser's
# credential popup:
#
#   any path, no cookie   -> the landing page (demo/landing), which is a
#                            login form prefilled with demo / demo
#   GET /login?u=demo&p=demo -> set the gate cookie, redirect to /
#   GET /login (wrong)    -> back to the form with ?denied=1
#   any path, cookie      -> the app container
#
# The credentials are public and printed on the form; the gate is a speed
# bump for crawlers and scanners, not a secret. DEMO_DOMAIN comes from the
# environment (bootstrap.sh writes it to .env); Caddy provisions and
# renews the certificate on its own.

{$DEMO_DOMAIN} {
	encode gzip

	@authed header_regexp Cookie jobd_demo=in

	@login `{http.request.uri.path} == "/login" && {http.request.uri.query.u} == "demo" && {http.request.uri.query.p} == "demo"`
	handle @login {
		# Not HttpOnly on purpose: the dashboard's user menu reads the
		# cookie to know it is running as the demo, and clears it to sign
		# out. It guards nothing secret.
		header +Set-Cookie "jobd_demo=in; Path=/; Max-Age=2592000; SameSite=Lax; Secure"
		redir * / 302
	}
	handle /login {
		redir * /?denied=1 302
	}

	handle @authed {
		reverse_proxy app:8100
	}

	handle {
		# Never cacheable: the same URL serves the app once the gate
		# cookie exists, and file_server's Last-Modified otherwise lets
		# the browser heuristically cache the landing page — which then
		# shadows the app right after login.
		header Cache-Control "no-store"
		root * /srv/landing
		try_files {path} /index.html
		file_server
	}
}
