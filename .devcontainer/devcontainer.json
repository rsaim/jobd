{
  "name": "jobd-ai",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/jobd-ai",
  "forwardPorts": [8000, 8765],
  "portsAttributes": {
    "8000": { "label": "jobd dashboard", "visibility": "private" },
    // The OAuth loopback callback. `jobd auth gmail` listens here inside the
    // container while the browser approving the consent runs on the host, so
    // the redirect only completes if the port is forwarded. VS Code usually
    // auto-forwards on listen, but that is a user setting — declaring it makes
    // the flow work regardless. Private: a public forward would put an open
    // OAuth callback on the internet.
    "8765": { "label": "jobd OAuth callback", "visibility": "private" }
  },
  "mounts": [
    "source=claude-config,target=/home/vscode/.claude,type=volume",
    "source=jobd-secrets,target=/home/vscode/.jobd,type=volume"
  ],
  "remoteEnv": {
    "DATABASE_URL": "postgresql://jobd:jobd@db:5432/jobd"
  },
  // ~/.aws is a symlink to the jobd-secrets volume. Nothing under $HOME except
  // the two mounts above survives a rebuild, so a real ~/.aws means
  // re-authenticating every time. Symlinking rather than setting
  // AWS_{CONFIG,SHARED_CREDENTIALS}_FILE keeps the CLI's default layout intact,
  // so tools that hardcode ~/.aws work too. See SECURITY.md §2.
  "postCreateCommand": "sudo chown -R $(whoami):$(whoami) /home/vscode/.claude /home/vscode/.jobd && mkdir -p /home/vscode/.jobd/aws && chmod 700 /home/vscode/.jobd/aws && rm -rf /home/vscode/.aws && ln -s /home/vscode/.jobd/aws /home/vscode/.aws && bash setup.sh all && bash setup.sh project",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}